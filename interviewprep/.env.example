# Flutter build-time configuration.
# The same values are used for Android and iOS.
API_BASE_URL=https://your-api.onrender.com
BACKEND_API_KEY=replace-with-the-same-key-configured-on-the-backend

# Example commands:
# flutter run --dart-define=API_BASE_URL=https://your-api.onrender.com --dart-define=BACKEND_API_KEY=...
# flutter build apk --release --dart-define=API_BASE_URL=https://your-api.onrender.com --dart-define=BACKEND_API_KEY=...
# flutter build ios --release --dart-define=API_BASE_URL=https://your-api.onrender.com --dart-define=BACKEND_API_KEY=...

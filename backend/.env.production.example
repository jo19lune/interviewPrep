# ============================================================
# Render / Neon — Production template (.env.example)
# ============================================================
# Ce fichier est un modèle. Ne commitez JAMAIS le vrai .env.
# Copiez-le en .env et remplacez toutes les valeurs "replace-with-*".
# ============================================================

# ==========================
# 🚀 Application
# ==========================
APP_ENVIRONMENT=production
DEBUG=False
APP_NAME=InterviewPrep API
APP_VERSION=2.0.1
HOST=0.0.0.0
PORT=10000

# ==========================
# 🔐 Sécurité & JWT
# ==========================
# Générer avec : python -c "import secrets; print(secrets.token_urlsafe(64))"
BACKEND_API_KEY=replace-with-a-long-random-application-key
SECRET_KEY=replace-with-a-long-random-jwt-secret

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256

# Anti brute-force (login / OTP)
MAX_ATTEMPTS=5
LOCKOUT_TIME=300

# ==========================
# 🗄️ Base de données (Neon)
# ==========================
# URL "pooled" (avec -pooler) pour l'API FastAPI
# ⚠️ Remplacer sslmode=require par ssl=require et postgresql:// par postgresql+asyncpg://
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@POOLER_HOST/DATABASE?ssl=require

# URL "directe" (sans -pooler) pour Alembic UNIQUEMENT
DATABASE_DIRECT_URL=postgresql://USER:PASSWORD@DIRECT_HOST/DATABASE?sslmode=require

DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5

# ==========================
# ⚡ Redis (Render Key Value ou Upstash)
# ==========================
# Sur Render (production) : utiliser l'Internal URL (redis://)
# En local avec External URL : utiliser rediss:// (TLS)
# En local avec Docker : redis://localhost:6379/0
REDIS_URL=redis://USER:PASSWORD@REDIS_HOST:6379/0

# ==========================
# 🌐 Frontend & CORS
# ==========================
FRONTEND_URL=https://your-frontend.example.com

# ==========================
# 🤖 IA (Provider & Clés)
# ==========================
# On change le fournisseur actif pour Groq
AI_PROVIDER=groq

# On ajoute la clé Groq (gardez la clé OpenAI commentée si vous voulez y revenir plus tard)
GROQ_API_KEY=votre_cle_api_groq_ici
# OPENAI_API_KEY=sk-proj-...

# ==========================
# 🤖 IA (Modèles)
# ==========================
# Modèles Groq (Gratuits et très rapides)
AI_PRIMARY_MODEL=llama-3.3-70b-versatile
AI_FALLBACK_MODEL=llama-3.1-8b-instant

# ==========================
# 🤖 IA (Liste des modèles pour le frontend)
# ==========================
# Remplacez la liste OpenAI par des modèles Groq
AI_MODEL_ID_1=llama-3.3-70b-versatile
AI_MODEL_ID_2=llama-3.1-8b-instant
AI_MODEL_ID_3=mixtral-8x7b-32768
AI_MODEL_ID_4=gemma2-9b-it
# (Ajoutez-en d'autres selon vos besoins)


# ==========================
# 📧 Email (SMTP — soumission authentifiée)
# ==========================
# Port 587 + STARTTLS. Le port 25 est bloqué par tous les hébergeurs ; les
# ports 465/587 aussi sur le free tier de Render (ce projet est en `starter`).
#
# ⚠️ Gmail refuse le mot de passe du compte sur smtp.gmail.com.
# SMTP_PASSWORD doit être un MOT DE PASSE D'APPLICATION à 16 caractères
# (Compte Google → Sécurité → Validation en 2 étapes → Mots de passe
# d'application). Un mot de passe de compte produit un 535, permanent : aucun
# retry, aucun email, et un 503 honnête au lieu d'un faux « Code envoyé ».
# Plafond Google : ~500 messages/jour.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=votre-adresse-gmail
SMTP_PASSWORD=votre_mot_de_passe_application_16_caracteres
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT_SECONDS=8
# Doit correspondre au compte authentifié, sinon Gmail réécrit l'émetteur.
DEFAULT_FROM_EMAIL=noreply@example.com

# ==========================
# 🔑 OAuth Google
# ==========================
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID
# ⚠️ Ce doit être un client de type **Web** : il sert d'audience à l'idToken
# que le backend vérifie. Le client Android ne convient pas.
GOOGLE_CLIENT_ID=123-yyy.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_REDIRECT_URI=https://your-api.onrender.com/auth/google/callback

# ==========================
# 🔒 2FA par email (OTP)
# ==========================
EMAIL_2FA_ENABLED=False
EMAIL_OTP_TTL_MINUTES=10
EMAIL_OTP_MAX_ATTEMPTS=5
EMAIL_2FA_OTP_TTL_MINUTES=10
PASSWORD_RESET_CODE_TTL_MINUTES=30

# ==========================
# 🖼️ Stockage d'images (Cloudinary)
# ==========================
STORAGE_PROVIDER=cloudinary
# UPLOAD_DIR=/tmp/media
# UPLOAD_BASE_URL=https://your-api.onrender.com/media
CLOUDINARY_CLOUD_NAME=replace-with-cloud-name
CLOUDINARY_API_KEY=replace-with-cloudinary-key
CLOUDINARY_API_SECRET=replace-with-cloudinary-secret
CLOUDINARY_FOLDER=interviewprep/avatars
# ⚠️ Cloudinary n'attribue que des noms alphanumériques courts (dab1234xy).
# Un nom lisible comme « interviewprep_storage » est invalide.
MAX_UPLOAD_BYTES=5242880
# Render / Neon production template
APP_ENVIRONMENT=production
DEBUG=False
APP_NAME=InterviewPrep API
APP_VERSION=2.0.1
HOST=0.0.0.0
PORT=10001

# Generate a long random value; do not commit the real value.
BACKEND_API_KEY=replace-with-a-long-random-application-key
SECRET_KEY=replace-with-a-long-random-jwt-secret
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256

# Neon: pooled URL for the API, direct URL for Alembic.
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@POOLER_HOST/DATABASE?ssl=require
DATABASE_DIRECT_URL=postgresql://USER:PASSWORD@DIRECT_HOST/DATABASE?sslmode=require
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5

REDIS_URL=redis://USER:PASSWORD@REDIS_HOST:6379/0
FRONTEND_URL=https://your-frontend.example.com

# AI — n'importe quel fournisseur compatible OpenAI.
# AI_PROVIDER est consommé par le code et sélectionne un preset d'URL :
# openai | groq | openrouter | together | cerebras | deepseek |
# sambanova | mistral
AI_PROVIDER=openai
# OPENAI_API_KEY n'est plus obligatoire : avec AI_PROVIDER=groq, c'est
# GROQ_API_KEY qui porte la clé active. Les deux restent acceptés.
OPENAI_API_KEY=replace-with-openai-key
# GROQ_API_KEY=gsk-replace-with-groq-key
# OPENROUTER_API_KEY=sk-or-replace-with-key
# AI_BASE_URL=https://custom-endpoint/v1   # prioritaire sur le preset
# AI_API_KEY=replace-with-key               # prioritaire sur la clé du preset

# Secours : fournisseur DIStinct, indispensable si le compte principal est à
# credit. Sur le même compte, un quota épuisé ne se récupère pas en changeant
# de modèle.
# AI_FALLBACK_BASE_URL=https://api.groq.com/openai/v1
# AI_FALLBACK_API_KEY=gsk-replace-with-key

AI_PRIMARY_MODEL=gpt-4o
AI_FALLBACK_MODEL=gpt-4o-mini

# Un quota facturé épuisé (insufficient_quota / credit_balance_exhausted) n'est
# pas un rate-limit : aucun retry ne peut aboutir. Le coupe-circuit évite de
# payer ~7 s d'appels voués à l'échec sur chaque requête.
AI_MAX_RETRIES=0
AI_QUOTA_CIRCUIT_THRESHOLD=3
AI_QUOTA_CIRCUIT_COOLDOWN_SECONDS=120

AI_FEATURE_GENERATE_EXERCISES=True
AI_FEATURE_TRANSCRIBE_AUDIO=True
AI_FEATURE_GENERATE_QUESTIONS=True
AI_FEATURE_GENERATE_FEEDBACK=True

# Liste des modèles OpenAI disponibles (sélecteur frontend)
# ⚠️ Les modèles "reasoning" (famille o-serie) sont volontairement exclus :
# ai_client.py envoie toujours temperature=0.7, non accepté par ces modèles.
OPENAI_MODEL_ID_1=gpt-4o
OPENAI_MODEL_ID_2=gpt-4o-mini
OPENAI_MODEL_ID_3=gpt-4.1
OPENAI_MODEL_ID_4=gpt-4.1-mini
OPENAI_MODEL_ID_5=gpt-4-turbo
OPENAI_MODEL_ID_6=gpt-4
OPENAI_MODEL_ID_7=gpt-3.5-turbo
OPENAI_MODEL_ID_8=gpt-4.1-nano
OPENAI_MODEL_ID_9=gpt-5
OPENAI_MODEL_ID_10=gpt-5-mini
OPENAI_MODEL_ID_11=gpt-5-nano

# Email — Brevo par HTTPS (recommandé en cloud).
# Render et la plupart des hébergeurs bloquent les ports SMTP sortants : le
# SMTP y échoue silencieusement, ce qui produisait un « Code envoyé » alors
# qu'aucun email n'était parti. L'API REST passe par HTTPS/443.
# EMAIL_PROVIDER : brevo | smtp | auto (auto = brevo si BREVO_API_KEY, sinon smtp)
EMAIL_PROVIDER=brevo
BREVO_API_KEY=xkeysib-replace-with-brevo-key
BREVO_API_URL=https://api.brevo.com/v3/smtp/email
EMAIL_HTTP_TIMEOUT_SECONDS=8
DEFAULT_FROM_EMAIL=noreply@example.com

# Repli SMTP (uniquement si EMAIL_PROVIDER=smtp ou auto sans clé Brevo).
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=replace-with-smtp-user
SMTP_PASSWORD=replace-with-smtp-password
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False

# Google OAuth : le client ID doit être celui d'un client **Web** (type Web),
# car il sert d'audience à l'idToken que le backend vérifie.
GOOGLE_CLIENT_ID=123-yyy.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_REDIRECT_URI=https://your-api.onrender.com/auth/google/callback

EMAIL_2FA_ENABLED=False
EMAIL_OTP_TTL_MINUTES=10
EMAIL_OTP_MAX_ATTEMPTS=5
EMAIL_2FA_OTP_TTL_MINUTES=10
PASSWORD_RESET_CODE_TTL_MINUTES=30

STORAGE_PROVIDER=cloudinary
#UPLOAD_DIR=/tmp/media
#UPLOAD_BASE_URL=https://your-api.onrender.com/media
# ⚠️ Cloudinary n'attribue que des noms alphanumériques courts du type
# « dab1234xy ». Un nom lisible comme « interviewprep_storage » est INVALIDE.
CLOUDINARY_CLOUD_NAME=replace-with-cloud-name
CLOUDINARY_API_KEY=replace-with-cloudinary-key
CLOUDINARY_API_SECRET=replace-with-cloudinary-secret
CLOUDINARY_FOLDER=interviewprep/avatars
MAX_UPLOAD_BYTES=5242880

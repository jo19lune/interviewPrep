# Render / Neon production template
APP_ENVIRONMENT=production
DEBUG=False
APP_NAME=InterviewPrep API
APP_VERSION=2.0.1
HOST=0.0.0.0
PORT=10001

# Generate a long random value; do not commit the real value.
BACKEND_API_KEY=replace-with-a-long-random-application-key
SECRET_KEY=replace-with-a-long-random-jwt-secret
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256

# Neon: pooled URL for the API, direct URL for Alembic.
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@POOLER_HOST/DATABASE?ssl=require
DATABASE_DIRECT_URL=postgresql://USER:PASSWORD@DIRECT_HOST/DATABASE?sslmode=require
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5

REDIS_URL=redis://USER:PASSWORD@REDIS_HOST:6379/0
FRONTEND_URL=https://your-frontend.example.com

OPENAI_API_KEY=replace-with-openai-key
AI_PROVIDER=openai
AI_PRIMARY_MODEL=gpt-4o
AI_FALLBACK_MODEL=gpt-4o-mini
AI_FEATURE_GENERATE_EXERCISES=True
AI_FEATURE_TRANSCRIBE_AUDIO=True
AI_FEATURE_GENERATE_QUESTIONS=True
AI_FEATURE_GENERATE_FEEDBACK=True

# Liste des modèles OpenAI disponibles (sélecteur frontend)
# ⚠️ Les modèles "reasoning" (famille o-serie) sont volontairement exclus :
# ai_client.py envoie toujours temperature=0.7, non accepté par ces modèles.
OPENAI_MODEL_ID_1=gpt-4o
OPENAI_MODEL_ID_2=gpt-4o-mini
OPENAI_MODEL_ID_3=gpt-4.1
OPENAI_MODEL_ID_4=gpt-4.1-mini
OPENAI_MODEL_ID_5=gpt-4-turbo
OPENAI_MODEL_ID_6=gpt-4
OPENAI_MODEL_ID_7=gpt-3.5-turbo
OPENAI_MODEL_ID_8=gpt-4.1-nano
OPENAI_MODEL_ID_9=gpt-5
OPENAI_MODEL_ID_10=gpt-5-mini
OPENAI_MODEL_ID_11=gpt-5-nano

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=replace-with-smtp-user
SMTP_PASSWORD=replace-with-smtp-password
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=noreply@example.com
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_ANDROID_CLIENT_ID=456-yyy.apps.googleusercontent.com
EMAIL_2FA_ENABLED=False
EMAIL_OTP_TTL_MINUTES=10
EMAIL_OTP_MAX_ATTEMPTS=5
EMAIL_2FA_OTP_TTL_MINUTES=10

STORAGE_PROVIDER=cloudinary
#UPLOAD_DIR=/tmp/media
#UPLOAD_BASE_URL=https://your-api.onrender.com/media
CLOUDINARY_CLOUD_NAME=replace-with-cloud-name
CLOUDINARY_API_KEY=replace-with-cloudinary-key
CLOUDINARY_API_SECRET=replace-with-cloudinary-secret
CLOUDINARY_FOLDER=interviewprep/avatars

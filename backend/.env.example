# PostgreSQL
POSTGRES_USER=votre_nom_utilisateur
POSTGRES_PASSWORD=votre_mot_de_passe
POSTGRES_DB=votre_nom_de_base_de_donnees
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}
# En production Neon : URL pooled pour l'API, URL directe pour Alembic.
# DATABASE_URL=postgresql+asyncpg://user:password@ep-xxxx-pooler.region.aws.neon.tech/db?ssl=require
# DATABASE_DIRECT_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/db?sslmode=require
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5

# Redis
REDIS_URL=redis://redis:6379/0

# JWT
SECRET_KEY=votre_cle_secrete_pour_jwt
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256

# Sécurité
MAX_ATTEMPTS=5
LOCKOUT_TIME=300

# AI/OpenAI
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key
AI_PROVIDER=auto
AI_PRIMARY_MODEL=gemini-2.5-flash
AI_FALLBACK_MODEL=gemini-2.0-flash
AI_FEATURE_GENERATE_EXERCISES=True
AI_FEATURE_GENERATE_QUESTIONS=True
AI_FEATURE_GENERATE_FEEDBACK=True
OPENAI_MODEL_ID_1=gemini-2.5-flash
OPENAI_MODEL_ID_2=gemini-2.5-pro
OPENAI_MODEL_ID_3=gemini-2.0-flash
OPENAI_MODEL_ID_4=gemini-2.0-flash-001
OPENAI_MODEL_ID_5=gemini-2.0-flash-lite-001
OPENAI_MODEL_ID_6=gemini-2.0-flash-lite
OPENAI_MODEL_ID_7=gemini-2.5-flash-preview-tts
OPENAI_MODEL_ID_8=gemini-2.5-pro-preview-tts
OPENAI_MODEL_ID_9=gemma-4-26b-a4b-it
OPENAI_MODEL_ID_10=gemma-4-31b-it
OPENAI_MODEL_ID_11=gemini-flash-latest
OPENAI_MODEL_ID_12=gemini-2.5-flash-lite

# Email SMTP
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USERNAME=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=noreply@interviewprep.com
GOOGLE_CLIENT_ID=your-google-oauth-client-id
EMAIL_2FA_ENABLED=False
EMAIL_OTP_TTL_MINUTES=10
EMAIL_OTP_MAX_ATTEMPTS=5
EMAIL_2FA_OTP_TTL_MINUTES=10

# Application
APP_NAME=InterviewPrep API
APP_VERSION=1.0.0
DEBUG=True

# Frontend URLs (CORS)
# Note: Le backend accepte désormais toutes les origines HTTP/HTTPS.
# FRONTEND_URL est conservé pour compatibilité mais n'est plus requis pour le CORS.
FRONTEND_URL=http://localhost:3000,http://localhost:5173

# Serveur
HOST=0.0.0.0
PORT=9000

# Uploads
UPLOAD_DIR=/app/media
UPLOAD_BASE_URL=http://localhost:9000/media

# ==========================
# ⚙️ Configuration Stockage
# ==========================
# Fournisseur actif : local | s3 | azure | cloudinary
STORAGE_PROVIDER=local

# --- AWS S3 (utilisé si STORAGE_PROVIDER=s3) ---
# S3_BUCKET=mon-bucket
# S3_ACCESS_KEY=AKIAIOSFODNN7EXAMPLE
# S3_SECRET_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
# S3_REGION=eu-west-1
# S3_ENDPOINT=              # Laisser vide pour AWS standard, ou URL MinIO

# --- Azure Blob Storage (utilisé si STORAGE_PROVIDER=azure) ---
# AZURE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net
# AZURE_CONTAINER=avatars

# --- Cloudinary (utilisé si STORAGE_PROVIDER=cloudinary) ---
# CLOUDINARY_CLOUD_NAME=mon-cloud
# CLOUDINARY_API_KEY=...
# CLOUDINARY_API_SECRET=...
# CLOUDINARY_FOLDER=interviewprep/avatars
